{
  "name": "khatri-mobile-zone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "build:server": "tsx server/index.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server/index.js",
    "db:seed": "tsx server/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^5.0.0",
    "@tanstack/react-query": "^5.0.0",
    "better-sqlite3": "^13.0.0",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "framer-motion": "^11.0.0",
    "gsap": "^3.15.1",
    "lenis": "^1.1.0",
    "lucide-react": "^0.400.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^2.0.0",
    "uuid": "^9.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.0",
    "oxlint": "^0.3.0",
    "postcss": "^8.4.35",
    "prisma": "^5.0.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
